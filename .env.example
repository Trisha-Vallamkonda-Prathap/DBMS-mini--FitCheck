# ============================================================
# FitCheck Environment Configuration (Example Template)
# Copy this file to .env and fill in your local credentials.
# NEVER commit actual credentials or secret keys to version control.
# ============================================================

# Project Environment
PROJECT_NAME="FitCheck Fit Intelligence System"
ENVIRONMENT="development"
DEBUG=True

# MySQL Relational Database (SQLAlchemy & Direct Connection)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fitcheck
MYSQL_USER=fitcheck_user
MYSQL_PASSWORD=replace_with_secure_mysql_password

# Database URL used by SQLAlchemy (PyMySQL driver)
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# Redis Stack (Vector Database & Semantic Search)
# Note: Requires Redis Stack (with RedisSearch module enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_INDEX_NAME=fit_review_idx

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Authentication & Security
SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend API Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_V1_STR=/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
